        && request.auth.uid in d.participants && d.status == 'accepted'
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    function legacyUpgradeSource(id, d) {
      let direct = /databases/$(database)/documents/friendships/$(id);
      let reverseId = d.participants[1] + ':' + d.participants[0];
      let reverse = /databases/$(database)/documents/friendships/$(reverseId);
      let canonicalExists = exists(direct);
      let before = canonicalExists ? get(direct).data : get(reverse).data;
      return (canonicalExists ? !exists(reverse) : exists(reverse))
        && acceptedLegacySource(before, canonicalExists ? id : reverseId)
        && before.participants.toSet() == d.participants.toSet()
        && before.senderId == d.senderId && before.recipientId == d.recipientId
        && !existsAfter(reverse);
    }
    function acceptedLegacyUpgrade(id, d) {
      let cert = /databases/$(database)/documents/usedFriendshipCycles/$(d.cycleId);
      return cycleShape(d,id) && d.status == 'accepted' && legacyUpgradeSource(id,d)
        && !exists(cert) && getAfter(cert).data.relationshipId == id
        && getAfter(cert).data.participants == d.participants;
    }
    function cycleNoticeRequired(uid, itemId) {
      let path = /databases/$(database)/documents/users/$(uid)/activityInbox/$(itemId);
      // Its own create rule validates the exact payload and source transition.
      return !exists(path) && existsAfter(path);
    }
    function freshCycle(d, id) {
      let cert = /databases/$(database)/documents/usedFriendshipCycles/$(d.cycleId);
      return d.status == 'pending' && d.senderId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/friendships/$(d.participants[1] + ':' + d.participants[0]))
        && !exists(cert) && getAfter(cert).data.relationshipId == id
        && getAfter(cert).data.participants == d.participants
        && cycleNoticeRequired(d.recipientId, 'fr_' + d.cycleId);
    }
    match /friendships/{id} {
      allow create, update: if socialUser() && acceptedLegacyUpgrade(id,request.resource.data);
      allow delete: if socialUser() && acceptedLegacySource(resource.data,id)
        && resource.data.participants[0] > resource.data.participants[1]
        && acceptedLegacyUpgrade(resource.data.participants[1] + ':' + resource.data.participants[0],
          getAfter(/databases/$(database)/documents/friendships/$(resource.data.participants[1] + ':' + resource.data.participants[0])).data);
      allow create: if socialUser() && cycleShape(request.resource.data, id)
        && freshCycle(request.resource.data, id);
      allow update: if socialUser() && cycleShape(resource.data, id)
        && cycleShape(request.resource.data, id)
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && ((resource.data.status in ['withdrawn', 'rejected']
            && freshCycle(request.resource.data, id))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && ((resource.data.status == 'pending' && request.auth.uid == resource.data.recipientId
                && request.resource.data.status in ['accepted', 'rejected']
                && (request.resource.data.status == 'rejected'
                  || cycleNoticeRequired(resource.data.senderId, 'fa_' + resource.data.cycleId)))
              || (resource.data.status in ['pending', 'accepted']
                && request.resource.data.status == 'withdrawn'))));
    }
    match /usedFriendshipCycles/{cycleId} {
      allow read, update, delete: if false;
      allow create: if socialUser()
        && cycleId.matches('^[A-Za-z0-9_-]{16,64}$')
        && request.resource.data.keys().hasAll(['relationshipId', 'participants'])
        && request.resource.data.keys().hasOnly(['relationshipId', 'participants'])
        && certifiesCycle(request.resource.data);
      function certifiesCycle(d) {
        let path = /databases/$(database)/documents/friendships/$(d.relationshipId);
        let after = getAfter(path).data;
        return after.cycleId == cycleId && after.participants == d.participants
          && ((after.status == 'accepted' && acceptedLegacyUpgrade(d.relationshipId,after))
            || (after.status == 'pending' && after.senderId == request.auth.uid
              && (!exists(path) || (get(path).data.status in ['withdrawn', 'rejected']
                && get(path).data.cycleId != cycleId))));
      }
    }
    match /users/{uid}/activityInbox/{itemId} {
      allow create: if socialUser() && activityCreationEnabled() && cycleNotice();
      function cycleNotice() {
        let n = request.resource.data;
        return n.keys().hasAll(['schemaVersion', 'type', 'actorUid', 'createdAt', 'target', 'readAt', 'friendshipCycleId'])
          && n.keys().hasOnly(['schemaVersion', 'type', 'actorUid', 'createdAt', 'target', 'readAt', 'friendshipCycleId'])
          && n.schemaVersion is int && n.schemaVersion == 2
          && n.actorUid == request.auth.uid && uid != request.auth.uid
          && n.createdAt == request.time && n.readAt == null
          && n.target is map && n.target.keys().hasAll(['kind', 'id'])
          && n.target.keys().hasOnly(['kind', 'id']) && n.target.kind == 'friendship'
          && n.target.id is string && n.target.id.matches('^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$')
          && n.friendshipCycleId is string && n.friendshipCycleId.matches('^[A-Za-z0-9_-]{16,64}$')
          && cycleNoticeTransition(n);
      }
      function cycleNoticeTransition(n) {
        let path = /databases/$(database)/documents/friendships/$(n.target.id);
        let after = getAfter(path).data;
        return n.friendshipCycleId == after.cycleId
          && ((n.type == 'FRIEND_REQUEST' && itemId == 'fr_' + after.cycleId
              && after.status == 'pending' && after.senderId == request.auth.uid && after.recipientId == uid
              && (!exists(path) || (get(path).data.status in ['withdrawn', 'rejected']
                && get(path).data.cycleId != after.cycleId)))
            || (n.type == 'FRIEND_ACCEPTED' && itemId == 'fa_' + after.cycleId
              && after.status == 'accepted' && after.recipientId == request.auth.uid && after.senderId == uid
              && get(path).data.status == 'pending' && get(path).data.cycleId == after.cycleId));
      }
    }

    match /friendships/{id} {
      function participant() {
        return request.auth.uid in resource.data.participants;
      }
      // Transactions must be able to check both possible IDs before creating.
      // A missing document reveals no relationship fields.
      allow get: if socialUser()
        && request.auth.uid in id.split(':')
        && (!exists(/databases/$(database)/documents/friendships/$(id)) || participant());
      allow list: if socialUser() && participant();
      allow delete: if false;
      allow create: if socialUser() && validRequest();
      allow update: if socialUser()
        && !('cycleId' in resource.data) && !('cycleId' in request.resource.data)
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && (request.resource.data.status == 'rejected'
          || noticeRequired(resource.data.senderId, 'fa_' + id, 'FRIEND_REQUEST_ACCEPTED', 'friendship', id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      function validRequest() {
        let data = request.resource.data;
        return data.keys().hasAll(['participants', 'senderId', 'recipientId', 'status', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['participants', 'senderId', 'recipientId', 'status', 'createdAt', 'updatedAt'])
          && data.senderId == request.auth.uid
          && data.recipientId is string
          && data.senderId != data.recipientId
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string && data.participants[1] is string
          && data.participants[0].matches('^[A-Za-z0-9_-]+$')
          && data.participants[1].matches('^[A-Za-z0-9_-]+$')
          && data.senderId in data.participants && data.recipientId in data.participants
          && id == data.participants[0] + ':' + data.participants[1]
          && !existsAfter(/databases/$(database)/documents/friendships/$(data.participants[1] + ':' + data.participants[0]))
          && exists(/databases/$(database)/documents/socialProfiles/$(data.senderId))
          && exists(/databases/$(database)/documents/socialProfiles/$(data.recipientId))
          && data.status == 'pending'
          && noticeRequired(data.recipientId, 'fr_' + id, 'FRIEND_REQUEST_RECEIVED', 'friendship', id)
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }
    }
  }
}
