rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function socialUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Deployment-time constant. The rollout generator changes ONLY this literal.
    // Maintenance/recovery pauses new social events, never their safe cleanup.
    function activityCreationEnabled() {
      return true; // ACTIVITY_ROLLOUT_GATE
    }

    // The source requires the exact notice; the notice requires a real source
    // transition in this same atomic request. Rules never generate writes.
    function noticeRequired(uid, itemId, type, kind, id) {
      let d = getAfter(/databases/$(database)/documents/users/$(uid)/activityInbox/$(itemId)).data;
      return activityCreationEnabled()
        && !exists(/databases/$(database)/documents/users/$(uid)/activityInbox/$(itemId))
        && d.type == type && d.actorUid == request.auth.uid
        && d.target.kind == kind && d.target.id == id
        && d.createdAt == request.time && d.readAt == null;
    }
    function invitationRequired(uid, planId) {
      return noticeRequired(uid, 'jp_' + planId, 'JOINT_PLAN_INVITATION', 'jointPlan', planId);
    }
    function invitationRemoved(uid, planId) {
      return !existsAfter(/databases/$(database)/documents/users/$(uid)/activityInbox/$('jp_' + planId));
    }

    // The previous index may already be absent or belong to someone else.
    // Never require (or authorize) deleting another user's index.
    function releasedIndex(email, uid) {
      return email == null
        || !existsAfter(/databases/$(database)/documents/socialEmails/$(email))
        || getAfter(/databases/$(database)/documents/socialEmails/$(email)).data.uid != uid;
    }

    function validPrivateIndex(uid, previousEmail) {
      let email = request.resource.data.get('socialEmail', null);
      return socialUser()
        && email == request.auth.token.email.lower()
        && getAfter(/databases/$(database)/documents/socialEmails/$(email)).data.uid == uid
        && (previousEmail == email || releasedIndex(previousEmail, uid));
    }

    // Selection is never authorization in the new model. Legacy exception: Etapa 6.
    function validAuthority(d, uid) {
      return d.keys().hasAll(['schemaVersion', 'generation', 'authority', 'phase', 'origin', 'manifestId', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'generation', 'authority', 'phase', 'origin', 'manifestId', 'updatedAt'])
        && d.schemaVersion is int && d.schemaVersion == 1 && d.generation == 'multicareer-v1'
        && d.origin in ['legacy', 'new'] && d.manifestId == uid && d.updatedAt is timestamp
        && ((d.authority == 'legacy' && d.phase in ['pending', 'blocked'])
          || (d.authority == 'frozen' && d.phase in ['copying', 'validated', 'blocked'])
          || (d.authority == 'instances' && d.phase in ['complete', 'blocked']));
    }
    function legacyAuthority(uid) {
      let control = get(/databases/$(database)/documents/migrationUsers/$(uid));
      return control == null || (validAuthority(control.data, uid)
        && control.data.authority == 'legacy' && control.data.phase == 'pending');
    }
    function instanceAuthority(uid) {
      let d = get(/databases/$(database)/documents/migrationUsers/$(uid)).data;
      return validAuthority(d, uid) && d.authority == 'instances' && d.phase == 'complete';
    }
    function metadataWritable(uid) { return legacyAuthority(uid) || instanceAuthority(uid); }
    function socialAuthorityAvailable(uid) {
      let c = get(/databases/$(database)/documents/migrationUsers/$(uid));
      return c == null || (validAuthority(c.data, uid)
        && ((c.data.authority == 'legacy' && c.data.phase == 'pending')
          || (c.data.authority == 'instances' && c.data.phase == 'complete')));
    }
    function legacyAt(ids, index) { return ids.size() <= index || legacyAuthority(ids[index]); }
    // Protected per-plan freeze is independent of every participant's user authority.
    function legacySourceWritable(planId) {
      return !existsAfter(/databases/$(database)/documents/jointPlanLegacyControls/$(planId));
    }
    function legacyPlan(data) {
      return data.get('schemaVersion', 0) != 3 && legacyAuthority(data.ownerId) && legacyAt(data.inviteeIds, 0)
        && legacyAt(data.inviteeIds, 1) && legacyAt(data.inviteeIds, 2) && legacyAt(data.inviteeIds, 3);
    }

        function validFinalEvents(events, version) {
          return events is list && events.size() <= 1000 && (events.size() == 0
            || (version == 2
              && events.join('|').split('[|]') == events
              && events.join('|').matches('^[A-Za-z0-9._-]{1,32}@[0-9]{4}:(1C|2C)([|][A-Za-z0-9._-]{1,32}@[0-9]{4}:(1C|2C))*$')
              && !events.join('|').matches('.*@0000:.*')
              && events.join('|').replace('@[0-9]{4}:(1C|2C)', '').split('[|]').toSet().size() == events.size()));
        }
    function validProjectionScenario(s, version) {
      return s is map
        && s.keys().hasAll(['startPeriod', 'initialCapacity', 'maxPeriods', 'capacities', 'manualPeriods', 'finalEvents'])
        && s.keys().hasOnly(['startPeriod', 'initialCapacity', 'maxPeriods', 'capacities', 'manualPeriods', 'finalEvents'])
        && s.startPeriod is map && s.startPeriod.keys().hasAll(['year', 'term'])
        && s.startPeriod.keys().hasOnly(['year', 'term'])
        && s.startPeriod.year is int && s.startPeriod.year >= 1 && s.startPeriod.year <= 9979
        && s.startPeriod.term in ['1C', '2C']
        && s.initialCapacity is int && s.initialCapacity >= 1 && s.initialCapacity <= 9007199254740991
        && s.maxPeriods is int && s.maxPeriods >= 1 && s.maxPeriods <= 40
        && s.capacities is list && s.capacities.size() <= 40
        && s.manualPeriods is list && s.manualPeriods.size() <= 40
        && validFinalEvents(s.finalEvents, version);
    }
    // Administrative control is read-only to its owner, including in recovery.
    match /migrationUsers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /migrationManifests/{uid} {
      allow read, write: if false;
    }

    // Academic records remain private, including after accepting a friendship.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && legacyAuthority(uid)
        && !request.resource.data.keys().hasAny(['activeCareerInstanceId'])
        && (!('socialEmail' in request.resource.data) || validPrivateIndex(uid, null));
      allow update: if signedIn() && request.auth.uid == uid && validProfileMutation()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['socialEmail'])
          || validPrivateIndex(uid, resource.data.get('socialEmail', null)));
      allow delete: if signedIn() && request.auth.uid == uid && legacyAuthority(uid)
        && releasedIndex(resource.data.get('socialEmail', null), uid);
      function validProfileMutation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let selected = request.resource.data.get('activeCareerInstanceId', null);
        return (legacyAuthority(uid) && !changed.hasAny(['activeCareerInstanceId']))
          || (instanceAuthority(uid) && changed.hasOnly(['activeCareerInstanceId', 'updatedAt'])
            && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 2
            && request.resource.data.updatedAt == request.time
            && (selected == null || (instanceKey(selected)
              && getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(selected)).data.lifecycle == 'active')));
      }
      match /careers/{careerId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid && legacyAuthority(uid);
      }
      // v1.16 isolated metadata. No navigation, social access or academic children.
      function instanceKey(value) {
        return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$');
      }
      match /careerInstances/{instanceId} {
        function validInstanceConsent(s) {
          return s is map && s.keys().hasAll(['enabled', 'consentVersion', 'epoch', 'updatedAt'])
            && s.keys().hasOnly(['enabled', 'consentVersion', 'epoch', 'updatedAt'])
            && s.enabled is bool && s.epoch is int && s.epoch >= 0 && s.epoch <= 9007199254740991
            && s.consentVersion in [null, 1, 2] && (!s.enabled || s.consentVersion in [1, 2])
            && s.updatedAt is timestamp;
        }
        function lifecycleConsent() {
          let old = resource.data.get('sharing', null);
          let next = request.resource.data.get('sharing', null);
          return old == null ? next == null : (request.resource.data.lifecycle == 'archived'
            ? !next.enabled && next.epoch == old.epoch + 1 && next.consentVersion == old.consentVersion && next.updatedAt == request.time
            : next == old && !next.enabled);
        }
        function consentTransition() {
          let d = request.resource.data;
          let previous = resource.data.get('sharing', {'epoch': 0});
          let s = d.sharing;
          return resource.data.lifecycle == 'active' && d.lifecycle == 'active'
            && d.diff(resource.data).affectedKeys().hasOnly(['sharing', 'updatedAt'])
            && s.epoch == previous.epoch + 1 && s.updatedAt == request.time
            && (!s.enabled || currentPublishedConsent(s));
        }
        function currentPublishedConsent(s) {
          let d = getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)/sharing/snapshot).data;
          return d.schemaVersion == 3 && d.consentEpoch == s.epoch && d.updatedAt == request.time;
        }
        // Product archive cannot leave this instance selected, even in a malicious batch.
        // Legacy metadata compatibility remains unchanged; no bootstrap permission.
        function validLifecycleSelection() {
          return legacyAuthority(uid) || request.resource.data.lifecycle != 'archived'
            || clearedSelection();
        }
        function clearedSelection() {
          let before = get(/databases/$(database)/documents/users/$(uid)).data.get('activeCareerInstanceId', null);
          let after = getAfter(/databases/$(database)/documents/users/$(uid)).data.get('activeCareerInstanceId', null);
          return before == instanceId ? after == null : after != instanceId;
        }
        function validInstance() {
          let d = request.resource.data;
          return d.keys().hasAll(['schemaVersion', 'catalogId', 'lifecycle', 'createdAt', 'updatedAt', 'archivedAt'])
            && d.keys().hasOnly(['schemaVersion', 'catalogId', 'lifecycle', 'createdAt', 'updatedAt', 'archivedAt', 'sharing'])
            && (!('sharing' in d) || (validInstanceConsent(d.sharing) && (d.lifecycle != 'archived' || !d.sharing.enabled)))
            && d.schemaVersion is int && d.schemaVersion == 1
            && instanceKey(instanceId) && instanceKey(d.catalogId) && instanceId != d.catalogId
            && d.lifecycle in ['active', 'archived']
            && d.createdAt is timestamp && d.updatedAt == request.time
            && (d.lifecycle == 'active' ? d.archivedAt == null : d.archivedAt == request.time);
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && metadataWritable(uid) && validInstance()
          && (!('sharing' in request.resource.data) || (!request.resource.data.sharing.enabled
            && request.resource.data.sharing.epoch == 0 && request.resource.data.sharing.consentVersion == null
            && request.resource.data.sharing.updatedAt == request.time))
          && request.resource.data.lifecycle == 'active' && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/users/$(uid)/catalogMemberships/$(request.resource.data.catalogId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/catalogMemberships/$(request.resource.data.catalogId)).data.careerInstanceId == instanceId;
        allow update: if signedIn() && request.auth.uid == uid && request.resource.data.lifecycle != resource.data.lifecycle
          && metadataWritable(uid) && validInstance()
          && validLifecycleSelection()
          && lifecycleConsent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lifecycle', 'archivedAt', 'updatedAt', 'sharing'])
          && ((resource.data.lifecycle == 'active' && request.resource.data.lifecycle == 'archived')
            || (resource.data.lifecycle == 'archived' && request.resource.data.lifecycle == 'active'))
          && get(/databases/$(database)/documents/users/$(uid)/catalogMemberships/$(resource.data.catalogId)).data.careerInstanceId == instanceId;
        allow update: if socialUser() && request.auth.uid == uid && instanceAuthority(uid)
          && validInstance() && consentTransition();
        allow delete: if false;
      }
      match /careerInstances/{instanceId}/sharing/{snapshotId} {
        function metadataAfter() { return getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)).data; }
        function validSharedCodes(c) {
          return c is list && c.size() <= 1000 && c.toSet().size() == c.size()
            && (c.size() == 0 || (c.join('|').split('[|]') == c
              && c.join('|').matches('^[A-Za-z0-9._-]{1,32}([|][A-Za-z0-9._-]{1,32})*$')));
        }
        function currentSnapshot(d, m, p) {
          return d.schemaVersion == 3 && d.logicVersion == '1'
            && d.sourceProgressRevision == (p == null ? 0 : p.data.revision)
            && d.sourceUpdatedAt == (p == null ? m.createdAt : p.data.updatedAt)
            && d.consentEpoch == m.sharing.epoch
            && (m.sharing.consentVersion == 2 ? 'pendingFinalCodes' in d : !('pendingFinalCodes' in d));
        }
        function validSnapshot() {
          let d = request.resource.data;
          let m = metadataAfter();
          let p = getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)/academic/progress);
          return m.lifecycle == 'active' && m.sharing.enabled && currentSnapshot(d, m, p)
            && d.keys().hasAll(['schemaVersion', 'approvedCodes', 'availableToCourseCodes', 'sourceProgressRevision', 'sourceUpdatedAt', 'consentEpoch', 'logicVersion', 'catalogVersion', 'updatedAt'])
            && d.keys().hasOnly(['schemaVersion', 'approvedCodes', 'availableToCourseCodes', 'pendingFinalCodes', 'sourceProgressRevision', 'sourceUpdatedAt', 'consentEpoch', 'logicVersion', 'catalogVersion', 'updatedAt'])
            && d.updatedAt == request.time && d.catalogVersion is string && d.catalogVersion.size() <= 150
            && d.catalogVersion.matches('^' + m.catalogId + ':[a-f0-9]+$')
            && d.sourceProgressRevision is int && d.consentEpoch is int
            && validSharedCodes(d.approvedCodes) && validSharedCodes(d.availableToCourseCodes)
            && d.approvedCodes.toSet().intersection(d.availableToCourseCodes.toSet()).size() == 0
            && (!('pendingFinalCodes' in d) || (validSharedCodes(d.pendingFinalCodes)
              && d.pendingFinalCodes.toSet().intersection(d.approvedCodes.toSet()).size() == 0
              && d.pendingFinalCodes.toSet().intersection(d.availableToCourseCodes.toSet()).size() == 0));
        }
        function sharedSnapshot() {
          let m = get(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)).data;
          let p = get(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)/academic/progress);
          return instanceAuthority(uid) && instanceAuthority(request.auth.uid)
            && m.lifecycle == 'active' && m.sharing.enabled && acceptedPlanningFriend(uid)
            && compatibleReader(m.catalogId) && currentSnapshot(resource.data, m, p);
        }
        allow get: if snapshotId == 'snapshot' && signedIn() && (request.auth.uid == uid || (socialUser() && sharedSnapshot()));
        allow list: if false;
        allow create, update: if snapshotId == 'snapshot' && socialUser() && request.auth.uid == uid
          && instanceAuthority(uid) && validSnapshot();
        allow delete: if snapshotId == 'snapshot' && signedIn() && request.auth.uid == uid && instanceAuthority(uid);
      }
      // Owner + lifecycle authorize these children; navigation never does.
      match /careerInstances/{instanceId}/{kind}/{documentId} {
        function academicPath() {
          return (kind == 'academic' && documentId == 'progress') || (kind == 'planning' && documentId == 'projection');
        }
        function editable() {
          let m = getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(instanceId)).data;
          return signedIn() && request.auth.uid == uid && instanceAuthority(uid)
            && m.schemaVersion == 1 && m.lifecycle == 'active'
            && get(/databases/$(database)/documents/users/$(uid)/catalogMemberships/$(m.catalogId)).data.careerInstanceId == instanceId;
        }
        function validProgress() {
          let d = request.resource.data;
          return d.keys().hasAll(['schemaVersion', 'statusMap', 'revision', 'updatedAt'])
            && d.keys().hasOnly(['schemaVersion', 'statusMap', 'revision', 'updatedAt'])
            && d.schemaVersion is int && d.schemaVersion == 1 && d.statusMap is map
            && d.statusMap.values().toSet().hasOnly(['Pendiente', 'Cursando', 'Regularizada', 'Aprobada'])
            && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740991 && d.updatedAt == request.time;
        }
        function validInstanceProjection() {
          let d = request.resource.data;
          return d.keys().hasAll(['schemaVersion', 'revisionToken', 'scenario', 'updatedAt'])
            && d.keys().hasOnly(['schemaVersion', 'revisionToken', 'scenario', 'updatedAt'])
            && d.schemaVersion is int && d.schemaVersion == 3 && d.updatedAt == request.time
            && d.revisionToken is string && d.revisionToken.matches('^[A-Za-z0-9_-]{16,100}$')
            && validProjectionScenario(d.scenario, 2);
        }
        allow get: if academicPath() && signedIn() && request.auth.uid == uid && instanceAuthority(uid);
        allow list: if false;
        allow create: if academicPath() && editable() && (kind == 'academic'
          ? validProgress() && request.resource.data.revision == 1 : validInstanceProjection());
        allow update: if academicPath() && editable() && (kind == 'academic'
          ? validProgress() && request.resource.data.revision == resource.data.revision + 1
          : validInstanceProjection() && request.resource.data.revisionToken != resource.data.revisionToken);
        allow delete: if kind == 'planning' && documentId == 'projection' && editable();
      }
      match /catalogMemberships/{catalogId} {
        allow read: if signedIn() && request.auth.uid == uid;
        function compatibleFriend() {
          let m = get(/databases/$(database)/documents/users/$(uid)/careerInstances/$(resource.data.careerInstanceId)).data;
          return instanceAuthority(uid) && instanceAuthority(request.auth.uid)
            && acceptedPlanningFriend(uid) && compatibleReader(catalogId)
            && resource.data.schemaVersion == 1 && m.schemaVersion == 1
            && m.catalogId == catalogId && m.lifecycle == 'active';
        }
        allow get: if socialUser() && compatibleFriend();
        allow create: if signedIn() && request.auth.uid == uid && metadataWritable(uid)
          && request.resource.data.keys().hasAll(['schemaVersion', 'careerInstanceId'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'careerInstanceId'])
          && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
          && instanceKey(catalogId) && instanceKey(request.resource.data.careerInstanceId)
          && catalogId != request.resource.data.careerInstanceId
          && !exists(/databases/$(database)/documents/users/$(uid)/careerInstances/$(request.resource.data.careerInstanceId))
          && getAfter(/databases/$(database)/documents/users/$(uid)/careerInstances/$(request.resource.data.careerInstanceId)).data.catalogId == catalogId;
        allow update, delete: if false;
      }
      match /activityInbox/{itemId} {
        allow get, list: if socialUser() && request.auth.uid == uid;
        allow create: if socialUser() && activityCreationEnabled() && validNotice() && validNoticeTransition();
        allow update: if socialUser() && request.auth.uid == uid
          && resource.data.readAt == null && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow delete: if socialUser() && (request.auth.uid == uid || removingPlan());
        function validNotice() {
          let d = request.resource.data;
          return d.keys().hasAll(['schemaVersion', 'type', 'actorUid', 'createdAt', 'target', 'readAt'])
            && d.keys().hasOnly(['schemaVersion', 'type', 'actorUid', 'createdAt', 'target', 'readAt'])
            && d.schemaVersion is int && d.schemaVersion == 1
            && d.actorUid == request.auth.uid && d.actorUid != uid
            && d.createdAt == request.time && d.readAt == null
            && d.target is map && d.target.keys().hasAll(['kind', 'id'])
            && d.target.keys().hasOnly(['kind', 'id']) && d.target.id is string
            && ((d.type in ['FRIEND_REQUEST_RECEIVED', 'FRIEND_REQUEST_ACCEPTED']
              && d.target.kind == 'friendship' && d.target.id.matches('^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+$')
              && d.target.id.size() <= 257)
              || (d.type == 'JOINT_PLAN_INVITATION' && d.target.kind == 'jointPlan'
                && d.target.id.matches('^[A-Za-z0-9_-]{1,100}$')));
        }
        function validNoticeTransition() {
          let d = request.resource.data;
          return d.type == 'JOINT_PLAN_INVITATION' ? planInvitation(d.target.id)
            : friendNotice(d.type, d.target.id);
        }
        function friendNotice(type, id) {
          let path = /databases/$(database)/documents/friendships/$(id);
          let after = getAfter(path).data;
          return !('cycleId' in after) && (type == 'FRIEND_REQUEST_RECEIVED'
            ? itemId == 'fr_' + id && !exists(path) && after.status == 'pending'
              && after.senderId == request.auth.uid && after.recipientId == uid
            : itemId == 'fa_' + id && get(path).data.status == 'pending' && after.status == 'accepted'
              && after.recipientId == request.auth.uid && after.senderId == uid);
        }
        function planInvitation(id) {
          let path = /databases/$(database)/documents/jointPlans/$(id);
          let after = getAfter(path).data;
          return (after.get('schemaVersion', 0) == 2
              ? instanceAuthority(request.auth.uid) && socialAuthorityAvailable(uid)
              : legacyAuthority(uid) && legacyAuthority(request.auth.uid))
            && itemId == 'jp_' + id && uid in after.inviteeIds
            && after.get('invitedBy', {}).get(uid, after.ownerId) == request.auth.uid
            && (!exists(path) || !(uid in get(path).data.inviteeIds))
            && acceptedPlanningFriend(uid)
            // CREATE v2: the mandatory notice proves this UID's pending binding.
            // Keep this predicate and the parent's invitationRequired atomic link together.
            && (after.get('schemaVersion', 0) != 2 || exists(path)
              || validCreationRecipient(after));
        }
        function validCreationRecipient(p) {
          let b = p.participants[uid];
          return b.keys().hasAll(['careerInstanceId', 'bindingState'])
            && b.keys().hasOnly(['careerInstanceId', 'bindingState'])
            && b.careerInstanceId == null && b.bindingState == 'unresolved';
        }
        function removingPlan() {
          let id = itemId.replace('^jp_', '');
          let path = /databases/$(database)/documents/jointPlans/$(id);
          return itemId.matches('^jp_[A-Za-z0-9_-]{1,100}$')
            && get(path).data.ownerId == request.auth.uid && uid in get(path).data.inviteeIds
            && get(path).data.closed && get(path).data.get('deleting', false)
            && !existsAfter(path);
        }
      }
      match /careerProjections/{careerId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid && legacyAuthority(uid);
        allow list: if false;
        allow create: if signedIn() && request.auth.uid == uid && legacyAuthority(uid) && validProjection();
        allow update: if signedIn() && request.auth.uid == uid && legacyAuthority(uid) && validProjection()
          && request.resource.data.schemaVersion >= resource.data.schemaVersion;
        function validProjection() {
          let d = request.resource.data;
          let s = d.scenario;
          return d.keys().hasAll(['schemaVersion', 'careerId', 'revisionToken', 'scenario', 'updatedAt'])
            && d.keys().hasOnly(['schemaVersion', 'careerId', 'revisionToken', 'scenario', 'updatedAt'])
            && d.schemaVersion is int && d.schemaVersion in [1, 2] && d.careerId == careerId
            && careerId.size() > 0 && careerId.size() <= 100
            && d.revisionToken is string && d.revisionToken.matches('^[A-Za-z0-9_-]{16,100}$')
            && d.updatedAt == request.time
            && validProjectionScenario(s, d.schemaVersion);
        }
      }
    }

    match /socialProfiles/{uid} {
      // Hide legacy documents containing email until their owner migrates them.
      allow get: if socialUser() && (request.auth.uid == uid
        || !exists(/databases/$(database)/documents/socialProfiles/$(uid))
        || (resource.data.keys().hasOnly(['uid', 'name', 'photoURL', 'careerId', 'updatedAt'])));
      allow list, delete: if false;
      allow create, update: if socialUser() && request.auth.uid == uid && legacyAuthority(uid)
        && uid.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.keys().hasAll(['uid', 'name', 'photoURL', 'careerId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoURL', 'careerId', 'updatedAt'])
        && request.resource.data.uid == uid
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.socialEmail == request.auth.token.email.lower()
        && (!exists(/databases/$(database)/documents/socialProfiles/$(uid))
          || get(/databases/$(database)/documents/socialProfiles/$(uid)).data.get('email', null) == request.auth.token.email.lower()
          || releasedIndex(get(/databases/$(database)/documents/socialProfiles/$(uid)).data.get('email', null), uid))
